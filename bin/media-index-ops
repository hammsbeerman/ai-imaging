#!/usr/bin/env bash
set -euo pipefail

###############################################################################
# media-index-ops
#
# Safe wrapper for UI-triggered ops actions.
#
# Supports:
#   service <start|stop|restart|status> <service-name>
#   queue   <purge|count>               <queue-name>
###############################################################################

###############################################################################
# CONFIG
###############################################################################

REMOTE_APP_ROOT="/opt/media-index-prod/media_index"
REMOTE_VENV="/opt/media-index-prod/venv"
REMOTE_MANAGE_PY="$REMOTE_APP_ROOT/manage.py"
REMOTE_PYTHON_BIN="$REMOTE_VENV/bin/python"

SSH_BIN="/usr/bin/ssh"
SSH_OPTS=(
  -o BatchMode=yes
  -o StrictHostKeyChecking=yes
  -o ConnectTimeout=10
)

WORKER_HOST="ubuntu@192.168.0.66"
SYSTEMCTL_BIN="/bin/systemctl"

###############################################################################
# ALLOWLISTS
###############################################################################

LOCAL_SERVICES=(
  "media-index-gunicorn"
  "media-index-celery-beat"
)

REMOTE_WORKER_SERVICES=(
  "media-index-celery-worker"
  "media-index-celery-worker-ops"
  "media-index-celery-worker-preview"
  "media-index-celery-worker-text"
  "media-index-celery-worker-embedding"
  "media-index-celery-worker-mail"
  "media-index-celery-worker-metadata"
  "media-index-celery-worker-ocr"
  "media-index-celery-worker-scan"
)

ALLOWED_QUEUES=(
  "ops"
  "preview"
  "scan"
  "ocr"
  "mail"
  "control"
  "embedding"
  "metadata"
  "text"
)

###############################################################################
# HELPERS
###############################################################################

log() {
  printf '[media-index-ops] %s\n' "$*"
}

err() {
  printf '[media-index-ops] ERROR: %s\n' "$*" >&2
}

usage() {
  cat <<'EOF'
Usage:
  media-index-ops service <start|stop|restart|status> <service-name>
  media-index-ops queue   <purge|count>               <queue-name>

Examples:
  media-index-ops service restart media-index-celery-worker-preview
  media-index-ops service restart media-index-celery-beat
  media-index-ops service status media-index-celery-worker-text
  media-index-ops queue count preview
  media-index-ops queue purge text
EOF
  exit 2
}

contains() {
  local needle="$1"
  shift
  local item
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

run_local_systemctl() {
  local verb="$1"
  local service="$2"

  log "Running locally: $SYSTEMCTL_BIN $verb $service"
  exec "$SYSTEMCTL_BIN" "$verb" "$service"
}

run_remote_systemctl() {
  local verb="$1"
  local service="$2"

  log "Running on worker: $SYSTEMCTL_BIN $verb $service via $WORKER_HOST"
  exec "$SSH_BIN" "${SSH_OPTS[@]}" "$WORKER_HOST" \
    "sudo '$SYSTEMCTL_BIN' '$verb' '$service'"
}

run_remote_queue_command() {
  local verb="$1"
  local queue="$2"

  log "Running queue action on worker: $verb $queue via $WORKER_HOST"
  exec "$SSH_BIN" "${SSH_OPTS[@]}" "$WORKER_HOST" \
    "test -x '$REMOTE_PYTHON_BIN' && test -f '$REMOTE_MANAGE_PY' && cd '$REMOTE_APP_ROOT' && '$REMOTE_PYTHON_BIN' '$REMOTE_MANAGE_PY' ops_queue '$verb' '$queue'"
}

###############################################################################
# ARG PARSING
###############################################################################

[[ $# -eq 3 ]] || usage

MODE="$1"
VERB="$2"
TARGET="$3"

###############################################################################
# MAIN
###############################################################################

case "$MODE" in
  service)
    case "$VERB" in
      start|stop|restart|status) ;;
      *) err "Unsupported service verb: $VERB"; usage ;;
    esac

    if contains "$TARGET" "${LOCAL_SERVICES[@]}"; then
      run_local_systemctl "$VERB" "$TARGET"
    fi

    if contains "$TARGET" "${REMOTE_WORKER_SERVICES[@]}"; then
      run_remote_systemctl "$VERB" "$TARGET"
    fi

    err "Refusing unknown service: $TARGET"
    exit 20
    ;;

  queue)
    case "$VERB" in
      purge|count) ;;
      *) err "Unsupported queue verb: $VERB"; usage ;;
    esac

    if ! contains "$TARGET" "${ALLOWED_QUEUES[@]}"; then
      err "Refusing unknown queue: $TARGET"
      exit 21
    fi

    run_remote_queue_command "$VERB" "$TARGET"
    ;;

  *)
    err "Unsupported mode: $MODE"
    usage
    ;;
esac